  "components": [
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Tertiary quiet action with a transparent default surface.",
      "html": "<button class=\"ds-ghost\">View details</button>",
      "css": ".ds-ghost{font-family:\"IBM Plex Sans\",sans-serif;font-size:12px;font-weight:500;min-height:40px;padding:10px 14px;border-radius:6px;cursor:pointer;transition:background 150ms ease-out;background:transparent;color:var(--muted,#586574);border:1px solid transparent}.ds-ghost:hover:not(:disabled){background:var(--soft,#f6f8fa)}.ds-ghost:focus-visible{outline:3px solid var(--focus,#2459c4);outline-offset:3px}.ds-ghost:disabled{opacity:.5;cursor:not-allowed}@media(max-width:900px){.ds-ghost{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-ghost{transition:none}}"
    },
    {
      "name": "Destructive button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Explicit destructive action with fixed red fill and white text.",
      "html": "<button class=\"ds-danger\">Reject proposal</button>",
      "css": ".ds-danger{font-family:\"IBM Plex Sans\",sans-serif;font-size:12px;font-weight:500;min-height:40px;padding:10px 14px;border-radius:6px;cursor:pointer;transition:background 150ms ease-out;background:#b03338;color:#fff;border:1px solid transparent}.ds-danger:focus-visible{outline:3px solid var(--focus,#2459c4);outline-offset:3px}.ds-danger:disabled{opacity:.5;cursor:not-allowed}@media(max-width:900px){.ds-danger{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-danger{transition:none}}"
    },
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Consequential approval or primary action; actual fill remains blue in both themes.",
      "html": "<button class=\"ds-primary\">Review proposal</button>",
      "css": ".ds-primary{font-family:\"IBM Plex Sans\",sans-serif;font-size:12px;font-weight:500;min-height:40px;padding:10px 14px;border-radius:6px;cursor:pointer;transition:background 150ms ease-out;background:#2459c4;color:#fff;border:1px solid #2459c4}.ds-primary:hover:not(:disabled){background:#1a479f}.ds-primary:active:not(:disabled){background:#1a479f}.ds-primary:focus-visible{outline:3px solid var(--focus,#2459c4);outline-offset:3px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(max-width:900px){.ds-primary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet refresh or cancel action with an outline.",
      "html": "<button class=\"ds-secondary\">Refresh data</button>",
      "css": ".ds-secondary{font-family:\"IBM Plex Sans\",sans-serif;font-size:12px;font-weight:500;min-height:40px;padding:10px 14px;border-radius:6px;cursor:pointer;transition:background 150ms ease-out;background:var(--surface,#fff);color:var(--ink,#222a35);border:1px solid var(--rule,#dce2e8)}.ds-secondary:hover:not(:disabled){background:var(--soft,#f6f8fa);border-color:var(--muted,#586574)}.ds-secondary:focus-visible{outline:3px solid var(--focus,#2459c4);outline-offset:3px}@media(max-width:900px){.ds-secondary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Labeled input",
      "kind": "input",
      "refersTo": "input",
      "description": "Native field with visible label and invalid-state support.",
      "html": "<label class=\"ds-field\">Daily budget<input type=\"number\" value=\"100000\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:9px;font-family:\"IBM Plex Sans\",sans-serif;font-size:12px;font-weight:500;color:var(--ink,#222a35)}.ds-field input{background:var(--surface,#fff);color:var(--ink,#222a35);border:1px solid var(--rule,#dce2e8);border-radius:6px;padding:10px 12px;min-height:42px;font:400 13px \"IBM Plex Sans\",sans-serif}.ds-field input:focus-visible{outline:3px solid var(--focus,#2459c4);outline-offset:3px}.ds-field input[aria-invalid=\"true\"]{border-color:var(--danger,#b03338)}.ds-field input:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Neutral provenance badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Subordinate truthful status beside the content it qualifies.",
      "html": "<span class=\"ds-badge\">SIMULATED</span>",
      "css": ".ds-badge{display:inline-flex;font:500 11px/1.5 \"IBM Plex Sans\",sans-serif;padding:3px 7px;border:1px solid transparent;border-radius:4px;background:var(--soft,#f6f8fa);color:var(--muted,#586574)}"
    },
    {
      "name": "Working panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat evidence container with a thin rule and readable heading.",
      "html": "<section class=\"ds-panel\"><h2>Campaign efficiency</h2><p>Actual return versus baseline forecast</p></section>",
      "css": ".ds-panel{padding:22px;background:var(--surface,#fff);color:var(--ink,#222a35);border:1px solid var(--rule,#dce2e8);border-radius:12px;font:400 14px/1.6 \"IBM Plex Sans\",sans-serif}.ds-panel h2{margin:0;font-size:17px;font-weight:600;line-height:1.4;letter-spacing:-.012em}.ds-panel p{font-size:12px;color:var(--muted,#586574)}@media(max-width:600px){.ds-panel{padding:18px}.ds-panel h2{font-size:16px}}"
    },
    {
      "name": "Graphite navigation",
      "kind": "nav",
      "description": "Grouped graphite navigation with pale-blue selection.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><a href=\"#command\" aria-current=\"page\">Command Center</a><a href=\"#decisions\">Decision Center</a></nav>",
      "css": ".ds-nav{display:grid;gap:3px;padding:14px;background:#262b32;font:500 12px/1.4 \"IBM Plex Sans\",sans-serif}.ds-nav a{display:flex;align-items:center;min-height:44px;padding:10px;border-radius:6px;color:#c8d1db;text-decoration:none}.ds-nav a:hover{background:#343c47;color:#fff}.ds-nav a[aria-current]{background:#dce9ff;color:#173d85}.ds-nav a:focus-visible{outline:3px solid var(--focus,#2459c4);outline-offset:3px}"
    },
    {
      "name": "Financial comparison",
      "kind": "custom",
      "description": "Ruled financial value with explicit period comparison.",
      "html": "<div class=\"ds-metric\"><span>Net revenue</span><strong>₹12.48 L</strong><small>−6.2% vs prior 7 days</small></div>",
      "css": ".ds-metric{display:grid;gap:4px;padding:0 18px;border-left:1px solid var(--rule,#dce2e8);font:400 12px/1.5 \"IBM Plex Sans\",sans-serif;color:var(--muted,#586574);font-variant-numeric:tabular-nums}.ds-metric strong{font-size:26px;font-weight:600;letter-spacing:-.03em;color:var(--ink,#222a35)}.ds-metric small{font-size:11px;color:var(--danger,#b03338)}"
    },
    {
      "name": "Exact observation disclosure",
      "kind": "custom",
      "description": "Native progressive disclosure for precise chart values.",
      "html": "<details class=\"ds-details\"><summary>View chart data</summary><p>2026-10-07 · actual 2.30× · baseline 3.80×</p></details>",
      "css": ".ds-details{font:400 12px/1.6 \"IBM Plex Sans\",sans-serif;color:var(--muted,#586574)}.ds-details summary{cursor:pointer;min-height:36px;padding:8px 0;text-decoration:underline}.ds-details summary:hover{color:var(--accent,#2459c4)}.ds-details summary:focus-visible{outline:3px solid var(--focus,#2459c4);outline-offset:3px}@media(max-width:900px){.ds-details summary{min-height:44px}}"
    }
  ],
  "narrative": {
    "northStar": "Evidence Studio",
    "overview": "Evidence Studio pairs a real daily budget proposal with campaign evidence, a full-width attention register and source health. Strong blue selection on graphite navigation, self-hosted IBM Plex Sans and ruled financial rows follow the supplied references. Phone users see readable stacked budgets before broader metrics. The approved Forward Shift symbol and guarded approval contracts remain intact.",
    "keyCharacteristics": [
      "Cool reading ground and graphite navigation.",
      "Tabular financial values and thin comparison rules.",
      "Explicit evidence, forecast and execution-state labels.",
      "Native dialogs, disclosures and keyboard-accessible charts."
    ],
    "rules": [
      {
        "name": "Evidence before assertion",
        "body": "Keep measured, reconciled, forecast, simulated and unavailable states explicit. Color supports these labels; it cannot replace them.",
        "section": "colors"
      },
      {
        "name": "One reading voice",
        "body": "Use IBM Plex Sans for interface text and financial values. Reserve monospace for identifiers and code.",
        "section": "typography"
      },
      {
        "name": "Flat comparison surfaces",
        "body": "Use thin rules and tonal separation for working panels. Reserve physical elevation for the modal layer.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do align monetary comparisons and use tabular numerals.",
      "Do pair color with text, icons or line style for meaning.",
      "Do keep data provenance and model qualifiers near the evidence they describe.",
      "Do preserve visible focus, labels and feedback in both themes."
    ],
    "donts": [
      "Don't replace the approved Forward Shift symbol with generated decoration.",
      "Don't use decorative gradients, glows or sparkle branding in this analytical workspace.",
      "Don't present a forecast, probable driver or fixture interaction as an achieved outcome.",
      "Don't use the discarded Manrope/DM Sans and cream/purple palette for new screens."
    ]
  }
