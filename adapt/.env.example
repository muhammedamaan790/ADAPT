ADAPT_ENV=dev
ADAPT_WORKSPACE=demo
ADAPT_WORLD_URL=http://127.0.0.1:8100
ADAPT_GOOGLE_EXECUTION_MODE=mock
# Stage 2 only:
GROQ_API_KEY=

# Google Ads API v25 (spec §9.4): OAuth desktop client + refresh token, no developer token.
# Get the refresh token with: uv run python scripts/google_oauth_token.py
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# test manager account ID (digits only) and the test client account under it
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# Kaggle: save your API token to %USERPROFILE%\.kaggle\access_token (one line), never here.
